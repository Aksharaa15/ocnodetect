{
  "expo": {
    "name": "OcnoDetect",
    "slug": "ocnodetect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "sdkVersion": "54.0.0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scanwise.mobile",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.scanwise.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "693d0fff-6f5c-49c8-b383-3f231dfe75fc"
      }
    },
    "owner": "akashkrish10"
  }
}
